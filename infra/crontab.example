# deploy user; Ubuntu cron uses the host timezone for schedule evaluation.
# First set the host timezone: sudo timedatectl set-timezone Europe/Moscow
# TZ alone does not change Ubuntu cron schedule times. Preserve existing jobs.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 3 * * * /opt/flounder/infra/backup.sh
0 4 * * 0 /opt/flounder/infra/verify-latest-backup.sh
*/15 * * * * /opt/flounder/infra/check-disk.sh >> /home/deploy/backups/backup.log 2>&1
