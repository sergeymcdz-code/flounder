# deploy user; check the repository path: readlink -f ~/flounder
# Check the host timezone: timedatectl | grep 'Time zone'
# Ubuntu cron uses host timezone, not a TZ variable in this file.
# If changing it: sudo timedatectl set-timezone Europe/Moscow
# Then reload the cron timezone: sudo systemctl restart cron
# Encrypted backups: weekly job reminds the owner to verify off-host; no private key on this server.
# Preserve existing jobs; install only ONE schedule variant below.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
# Europe/Moscow: daily 03:00 MSK, Sunday 04:00 MSK, hourly disk check.
0 3 * * * "$HOME/flounder/infra/backup.sh"
0 4 * * 0 "$HOME/flounder/infra/verify-latest-backup.sh"
0 * * * * "$HOME/flounder/infra/check-disk.sh" >> "$HOME/backups/backup.log" 2>&1
# UTC alternative: uncomment these INSTEAD of the three lines above.
# 0 0 * * * "$HOME/flounder/infra/backup.sh"
# 0 1 * * 0 "$HOME/flounder/infra/verify-latest-backup.sh"
# 0 * * * * "$HOME/flounder/infra/check-disk.sh" >> "$HOME/backups/backup.log" 2>&1
# 0 6 * * 1 cd /home/deploy/flounder && /usr/bin/flock -n /home/deploy/backups/demo-calendar.lock /usr/bin/docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD":/repo -w /repo/scripts/demo node:22-alpine sh -eu -c 'npm ci && npx tsx calendar.ts --advance' >> /home/deploy/backups/demo-calendar.log 2>&1
