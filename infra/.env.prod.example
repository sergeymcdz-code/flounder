# Flounder demo stand — environment for infra/compose.prod.yaml.
# Copy to infra/.env.prod and fill in the values. infra/.env.prod is git-ignored: never commit it.
#   cp infra/.env.prod.example infra/.env.prod
# Maintenance scripts source this file in Bash: single-quote values containing
# spaces, $ or # so they stay literal (for example: PASSWORD='literal$value # text').

# Public domain of the stand (DNS A record must point to the server). No "https://", no trailing slash.
DOMAIN=demo.flounder.kz

# E-mail for Let's Encrypt notifications (certificate expiry warnings).
ACME_EMAIL=admin@flounder.kz

# PostgreSQL password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Optional, defaults are fine for the demo:
# POSTGRES_DB=sport_platform
# POSTGRES_USER=sport_user

# JWT signing secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Allowed CORS origins for /api/** (comma-separated). The SPA is served from the same origin,
# so the domain itself is enough; add http://localhost:5173 to call the stand API from a local frontend.
APP_CORS_ALLOWED_ORIGINS=https://demo.flounder.kz


# Payments provider for the demo: MANUAL (no YooKassa integration).
APP_PAYMENTS_PROVIDER=MANUAL

# Demo data seed flag (used by the T10 seed script / profile). Keep true on the demo stand.
DEMO_SEED=true

# Optional: server time zone used by the API container for logs.
# TZ=Europe/Samara

# Cron notifications. Leave empty until the bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# BACKUP_DIR=/home/deploy/backups
# BACKUP_KEEP_DAYS=30
# FILES_VOLUME=flounder_files
# Optional rclone remote in a Russian region; disabled when empty.
BACKUP_S3_REMOTE=
# Optional Sentry; no reporting with empty DSNs. Use separate projects per stand.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional bootstrap: creates this admin only if the email is absent; existing passwords stay untouched.
# APP_ADMIN_EMAIL=
# APP_ADMIN_PASSWORD=
# Participant documents. Local storage is the default; S3 is optional.
# FILES_STORAGE_DIR=  # default /data/files in compose
# base64 от 32 случайных байт: openssl rand -base64 32; потеря ключа = потеря всех документов, хранить в бэкапе отдельно от тома
APP_FILES_ENCRYPTION_KEY=
# APP_FILES_PROVIDER=  # local or s3
# APP_FILES_S3_ENDPOINT=  # Selectel/Yandex S3-compatible endpoint
# APP_FILES_S3_BUCKET=
# APP_FILES_S3_REGION=
# APP_FILES_S3_ACCESS_KEY=
# APP_FILES_S3_SECRET_KEY=
# S3 на стенде не включается без добавления его переменных в api.environment compose.
# M05: SMTP. Пустые значения используют безопасные defaults приложения.
# MAIL_ENABLED по умолчанию false: адресат/тема в INFO, тело только в DEBUG; письма сохраняются в outbox.
MAIL_HOST=
MAIL_PORT=
# auto: порт 465 — SSL/TLS, остальные — обязательный STARTTLS; starttls/ssl задают режим явно.
# none — только для локальных MailHog/Mailpit, без TLS.
MAIL_SECURITY=auto
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ENABLED=
# Базовый URL ссылок в письмах. В production compose fallback — https://${DOMAIN}.
APP_PUBLIC_URL=
