{
	servers {
		# Preserve HTTPS forwarded by the outer Caddy on the private edge network.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	@yookassa path /api/v1/payments/webhooks/yookassa
	request_body @yookassa {
		max_size 16KiB
	}

	@api path /api/* /actuator/health /actuator/health/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}
