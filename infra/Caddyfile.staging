{
	servers {
		# Preserve HTTPS forwarded by the outer Caddy on the private edge network.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	@api path /api/* /v3/api-docs* /swagger-ui* /actuator/health /actuator/health/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}
