# Copy to /home/deploy/.config/flounder/.env.staging (outside the source worktree).
DOMAIN=staging.sportgate.pro
POSTGRES_DB=sport_platform_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=replace-with-independent-staging-password
JWT_SECRET=replace-with-independent-staging-secret-at-least-32-characters
ADMIN_EMAIL="<email bootstrap-админа>"
ADMIN_PASSWORD="<задать>"
DEMO_PASSWORD="<задать, не менее 12 символов>"
# Optional independent Sentry projects:
SENTRY_DSN=
VITE_SENTRY_DSN=

# First administrator on a fresh database (same credentials as ADMIN_*).
APP_ADMIN_EMAIL="<email bootstrap-админа>"
APP_ADMIN_PASSWORD="<задать>"
