# Copy to /home/deploy/.config/flounder/.env.staging (outside the source worktree).
DOMAIN=staging.sportgate.pro
POSTGRES_DB=sport_platform_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=replace-with-independent-staging-password
# JWT_SECRET: Base64 от >=32 случайных байт. Сгенерируйте: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL="<email bootstrap-админа>"
ADMIN_PASSWORD="<задать>"
DEMO_PASSWORD="<задать, не менее 12 символов>"
# Optional independent Sentry projects:
SENTRY_DSN=
VITE_SENTRY_DSN=

# First administrator on a fresh database (same credentials as ADMIN_*).
APP_ADMIN_EMAIL="<email bootstrap-админа>"
APP_ADMIN_PASSWORD="<задать>"

# Лимиты регистрации (общие для /auth/register и /users; PLATFORM_ADMIN освобождён на /users).
APP_AUTH_REGISTRATION_MAX_PER_EMAIL=3
APP_AUTH_REGISTRATION_MAX_PER_IP=20
APP_AUTH_REGISTRATION_WINDOW=PT1H
# Лимиты запроса сброса; превышение сохраняет 202 без постановки письма в очередь.
APP_AUTH_PASSWORD_RESET_MAX_PER_EMAIL=3
APP_AUTH_PASSWORD_RESET_MAX_PER_IP=20
APP_AUTH_PASSWORD_RESET_WINDOW=PT1H

# Public age recipient only; keep the PRIVATE identity exclusively with the owner.
# With no recipient: Telegram warning, local plaintext only, remote upload refused.
BACKUP_AGE_RECIPIENT=
# Start with report-only; switch to Content-Security-Policy after browser QA.
CSP_HEADER=Content-Security-Policy-Report-Only
# Optional staging edge authentication; generate with caddy hash-password.
# Single-quote the bcrypt hash so Bash/Compose preserve literal $ characters.
STAGING_BASIC_AUTH_USER=staging
STAGING_BASIC_AUTH_HASH=

# Лимиты неверных паролей за APP_AUTH_LOGIN_WINDOW (по умолчанию PT15M).
# После демо 19.10 владелец стенда устанавливает 5 по паре email + IP и 30 по IP.
APP_AUTH_LOGIN_MAX_FAILURES=5
APP_AUTH_LOGIN_MAX_FAILURES_PER_IP=30
APP_AUTH_LOGIN_WINDOW=PT15M
