# Local development only; replace before deployment.
JWT_SECRET=local-development-secret-must-be-at-least-32-characters-long
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/sport_platform
SPRING_DATASOURCE_USERNAME=sport_user
SPRING_DATASOURCE_PASSWORD=sport_pass
APP_PAYMENTS_PROVIDER=MANUAL
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional YooKassa configuration
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/payment-return

# M02: keep the two-hour access default for the demo; opt in to one hour after updating the frontend.
# APP_JWT_ACCESS_TTL=PT1H
APP_PUBLIC_URL=http://localhost:5173

# Login failures per email or IP within the rolling window.
APP_AUTH_LOGIN_MAX_FAILURES=5
APP_AUTH_LOGIN_WINDOW=PT15M
