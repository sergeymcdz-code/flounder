# Internal static server for the SPA (used inside the `web` image only).
# TLS, domains and the /api proxy live in the edge Caddy: infra/Caddyfile.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode gzip zstd

	# Hashed Vite assets can be cached forever; index.html must always be revalidated
	# so that a new deploy is picked up by browsers.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# SPA fallback: unknown paths are handled by the React router.
	try_files {path} /index.html
	file_server
}
