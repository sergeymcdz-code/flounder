# Use only on a dedicated demo environment. Never commit .env.
DEMO_SEED_ENABLED=true
API_URL=http://localhost:8080
ADMIN_EMAIL=admin@flounder.demo
ADMIN_PASSWORD=Demo2026!
DEMO_PASSWORD=Demo2026!
# Optional per-account overrides (otherwise DEMO_PASSWORD is required).
# ORG_PASSWORD=
# SEC_PASSWORD=
# JUDGE_PASSWORD=
# PARENT_PASSWORD=
# Optional Saturday override for a repeatable rehearsal, in venue local time.
# DEMO_DATE=2026-10-17

# T01 accepts venueMeta; strict response validation is recommended on merged main.
# Set false only to warn and continue when metadata is missing (e.g. an old DTO).
# The seed always sends venueMeta, regardless of this switch.
REQUIRE_VENUE_META=true
# Preserve the leading space when naming the backup event.
EVENT_TITLE_SUFFIX=""
# EVENT_TITLE_SUFFIX=" · резерв"
# Needed only for reset.ts --apply; never commit actual database credentials.
# DEMO_DATABASE_URL=postgresql://user:password@localhost:5432/demo
