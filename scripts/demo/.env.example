# Use only on a dedicated demo environment. Never commit .env.
DEMO_SEED_ENABLED=true
API_URL=http://localhost:8080
ADMIN_EMAIL="<email bootstrap-админа>"
ADMIN_PASSWORD="<задать>"
DEMO_PASSWORD="<задать, не менее 12 символов>"
# Optional per-account overrides (otherwise DEMO_PASSWORD is required).
# ORG_PASSWORD=
# SEC_PASSWORD=
# JUDGE_PASSWORD=
# PARENT_PASSWORD=
# Demo day (any weekday); event dates are relative to this date in Europe/Samara.
DEMO_DATE=2026-10-19
DEMO_EVENTS=A,B,C
# Owner selects a separate participant mailbox, never an admin/staff account.
DEMO_OWNER_EMAIL=sergeymcdzkz@gmail.com
# Reset only: actual slugs from seed output, overrides DEMO_EVENTS.
# DEMO_SLUGS=pervenstvo-oblasti-sredi-yunoshey

# T01 accepts venueMeta; strict response validation is recommended on merged main.
# Set false only to warn and continue when metadata is missing (e.g. an old DTO).
# The seed always sends venueMeta, regardless of this switch.
REQUIRE_VENUE_META=true
# Preserve the leading space when naming the backup event.
EVENT_TITLE_SUFFIX=""
# EVENT_TITLE_SUFFIX=" · резерв"
# Needed only for reset.ts --apply; never commit actual database credentials.
# DEMO_DATABASE_URL=postgresql://user:password@localhost:5432/demo

# S10 calendar. Keep the seed anchor fixed; --advance reads it from event descriptions.
# CALENDAR_START=2026-07-27
CALENDAR_WEEKS=25
CALENDAR_PREFIX=""
# Reset calendar events instead of S02 A/B/C:
# DEMO_CALENDAR=true
